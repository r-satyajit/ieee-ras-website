# IEEE RAS Website - Git Ignore Rules
# Protect secrets, environment files, and local runtime configurations

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
scripts/config.js
scripts/secrets.js

# Operating System Cache & Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj

# Dependency Cache & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tmp
dist/
build/
