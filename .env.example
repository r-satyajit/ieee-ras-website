# ===================================================
# IEEE RAS Website - Environment Configuration Template
# ===================================================
# Copy this file to .env or configure in Vercel Project Settings > Environment Variables.
# DO NOT commit real secrets or passwords to Git repository.

# Serverless Cloud PostgreSQL Database (Neon / Supabase / Vercel Postgres)
# Example (Neon): postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Default Authentication Passcodes (Initial setup)
DEFAULT_LEAD_PASSWORD=your_secure_lead_password
DEFAULT_MEMBER_PASSWORD=your_secure_member_password
DEFAULT_PARTICIPANT_PASSWORD=your_secure_participant_password

# Leadership & Chapter Identity
LEAD_NAME="Chapter Lead"
LEAD_EMAIL="lead@vitstudent.ac.in"
LEAD_GITHUB_USER="ieee-ras-lead"
LEAD_GITHUB_URL="https://github.com/ieee-ras-vit"
LEAD_LINKEDIN_URL="https://linkedin.com/company/ieee-ras-vit"
GITHUB_REPO_URL="https://github.com/ieee-ras-vit/ieee-ras-website"

# Optional Cloud Integrations & Service APIs
GEMINI_API_KEY=
WEBRTC_SIGNALING_URL="https://meet.ieee-ras.org"
